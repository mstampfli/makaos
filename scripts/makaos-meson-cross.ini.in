# MakaOS meson cross-compile file (template).
# Generated at build time by scripts/gen-meson-cross.sh which substitutes
# @REPO_ROOT@ with the current repo path.  Do NOT hand-edit the generated
# copy at build/makaos-meson-cross.ini — edit this .in template instead.
# Pkg-config sysroot is set via PKG_CONFIG_* env vars at invocation time
# because meson's built-in sys_root handling collides with our sysroot
# being mutable across builds.

[binaries]
c        = '@REPO_ROOT@/toolchain/bin/x86_64-pc-makaos-gcc'
cpp      = '@REPO_ROOT@/toolchain/bin/x86_64-pc-makaos-g++'
ar       = '@REPO_ROOT@/toolchain/bin/x86_64-pc-makaos-ar'
strip    = '@REPO_ROOT@/toolchain/bin/x86_64-pc-makaos-strip'
pkg-config = 'pkg-config'

[host_machine]
system     = 'makaos'
cpu_family = 'x86_64'
cpu        = 'x86_64'
endian     = 'little'

[properties]
needs_exe_wrapper = true
sys_root          = '@REPO_ROOT@/build/sysroot'

[built-in options]
c_args      = ['--sysroot=@REPO_ROOT@/build/sysroot', '-nostdinc', '-I@REPO_ROOT@/build/sysroot/usr/include', '-I@REPO_ROOT@/toolchain/lib/gcc/x86_64-pc-makaos/14.2.0/include', '-D__STDC_ISO_10646__=201706L']
cpp_args    = ['--sysroot=@REPO_ROOT@/build/sysroot', '-nostdinc', '-I@REPO_ROOT@/build/sysroot/usr/include', '-I@REPO_ROOT@/toolchain/lib/gcc/x86_64-pc-makaos/14.2.0/include', '-D__STDC_ISO_10646__=201706L']
c_link_args = ['--sysroot=@REPO_ROOT@/build/sysroot', '-specs=@REPO_ROOT@/scripts/makaos-gcc-specs']
cpp_link_args = ['--sysroot=@REPO_ROOT@/build/sysroot', '-specs=@REPO_ROOT@/scripts/makaos-gcc-specs']
